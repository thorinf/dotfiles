# font
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14
font-thicken = false
adjust-cell-height = -2

# appearance - cyberdream theme with gruvbox-dark-hard background
theme = cyberdream
background = #1d2021

# color rendering
alpha-blending = linear-corrected
window-colorspace = display-p3

macos-titlebar-style = hidden
# Note: GTK titlebar behavior can vary across desktops/versions.
gtk-titlebar = false
window-decoration = true
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

# behavior
mouse-hide-while-typing = true
copy-on-select = true
scrollback-limit = 10000000
gtk-single-instance = false
window-vsync = true
macos-option-as-alt = right

keybind = shift+enter=text:\x1b\r

# word / line navigation in the shell (readline sequences; zsh viins binds these)
keybind = alt+left=esc:b
keybind = alt+right=esc:f
keybind = alt+backspace=text:\x17
keybind = super+left=text:\x01
keybind = super+right=text:\x05
